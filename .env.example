# Local development. Coolify needs only PUBLIC_ORIGIN and APP_PASSWORD as runtime variables.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
APP_PASSWORD=
BASE_PATH=
# Empty uses the repository root locally. The Docker image sets /data.
DATA_DIR=
# Keys, custom endpoints, subtitle tokens and YouTube cookies go in Connections.
TRANSCRIBE_BACKEND=elevenlabs
# Empty uses the provider default: scribe_v2 for direct ElevenLabs.
TRANSCRIPTION_MODEL=
# First-start scanner setting; Library controls persist after that.
SCANNER_ENABLED=false
MAX_QUEUED_JOBS=20
PAUSE_ON_FAILURE=true
# Local review keeps temporary audio; Docker defaults to false for batch runs.
KEEP_INTERMEDIATES=true
# Prepare a persistent screening automatically; edits never trigger paid inference.
PREPARE_REVIEW=true
MAX_TEMP_BYTES=12884901888
MIN_FREE_DISK_BYTES=1073741824
CLOUD_MAX_ESTIMATED_COST=5
# Optional account-specific rate; the public catalog rate is not your invoice.
CLOUD_PRICE_PER_MINUTE=
CLOUD_PRICE_CURRENCY=USD
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_CPU_THREADS=2
# Increase on a fresh local install when the first model download needs more time.
WORKER_START_TIMEOUT_MS=300000
# Set true only if faster-whisper is installed in WHISPER_PYTHON_BIN.
LOCAL_WHISPER_ENABLED=false
# Cloud-only setup. Set true after installing optional requirements.txt for Silero.
LOCAL_AUDIO_ENABLED=false
# Local setup: use absolute paths to your installed Python environment and yt-dlp.
PYTHON_BIN=python3
WHISPER_PYTHON_BIN=
WHISPER_LIBRARY_PATH=
YTDLP_BIN=yt-dlp
# Native local translation: uses this user's existing `codex login` (ChatGPT).
# Docker bundles the pinned CLI; sign in there with `codex login --device-auth`.
# Its separate login persists under /data/data/private/codex. No host login is copied.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_TRANSLATION_TIMEOUT_MS=1800000
# Default for uploads/scanned movies. Enable after signing Codex in.
TRANSLATION_ENABLED=false

# Comma-separated IPs/CIDRs of your actual reverse proxy; never trust arbitrary clients.
TRUSTED_PROXIES=
# Allow submitted ASR responses to finish; container stop grace must exceed this by 30s.
SHUTDOWN_GRACE_MS=1800000
# Optional 32-byte hex vault key from an external secret store; never written by the app.
CREDENTIALS_MASTER_KEY=
# Transcript text stays out of diagnostic stdout unless explicitly enabled.
LOG_TRANSCRIPT_TEXT=false

# Personal workspace (default) or hosted accounts with strictly per-user BYOK.
APP_MODE=personal
SIGNUP_ENABLED=true
MAX_ACCOUNTS=1000
# Source for the exact version you host, including modifications (AGPL section 13).
SOURCE_URL=https://github.com/mrtdlgc/yesilcam-pipeline
# Hosted ChatGPT plan use requires OpenAI approval and a registered callback.
# Leave disabled until approval. Never reuse Codex CLI's OAuth client ID.
CHATGPT_PLAN_USAGE_ENABLED=false
CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_CLIENT_SECRET=
