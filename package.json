{
  "name": "yesilcam-subtitle-pipeline",
  "version": "2.0.0",
  "description": "Automated subtitle generation pipeline for Yeşilçam films",
  "main": "build/server.js",
  "type": "module",
  "scripts": {
    "start": "node build/server.js",
    "dev": "node --watch --watch-path=config.ts --watch-path=server.ts --watch-path=scripts --watch-path=public scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --import tsx --test --test-concurrency=1 scripts/tests/*.test.ts",
    "build": "rm -rf build && tsc -p tsconfig.build.json && tsc -p tsconfig.browser.json && node build/scripts/copy-assets.js",
    "compare:transcription": "tsx scripts/compare-transcribers.ts",
    "recover:transcription": "tsx scripts/reconcile-transcription.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:providers": "tsx scripts/generate-provider-docs.ts",
    "test:browser": "npm run build && node scripts/tests/hybrid-browser.mjs && node scripts/tests/hosted-browser.mjs"
  },
  "keywords": [
    "subtitles",
    "whisper",
    "yesilcam"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@openai/codex": "0.164.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "jose": "6.2.13"
  },
  "engines": {
    "node": ">=22.13 <27"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
