{
  "name": "yesilcam-subtitle-pipeline",
  "version": "2.0.0",
  "description": "Automated subtitle generation pipeline for Yeşilçam films",
  "main": "build/server.js",
  "type": "module",
  "scripts": {
    "start": "node build/server.js",
    "dev": "npm run build && node --watch build/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "node --import tsx --test --test-concurrency=1 scripts/tests/*.test.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && node build/scripts/copy-assets.js",
    "compare:transcription": "tsx scripts/compare-transcribers.ts",
    "recover:transcription": "tsx scripts/reconcile-transcription.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "subtitles",
    "whisper",
    "yesilcam"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@openai/codex": "0.164.0",
    "dotenv": "18.0.9",
    "express": "5.3.0"
  },
  "engines": {
    "node": ">=22.12 <27"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
